# El repo se edita en Windows pero se despliega en Linux. Sin esto, git
# convertiría a CRLF y en el servidor fallaría con "bad interpreter: /bin/bash^M".
* text=auto eol=lf

# Archivos que SIEMPRE deben tener finales LF, pase lo que pase
deploy/install.sh        text eol=lf
deploy/ovpn-web-helper   text eol=lf
deploy/ovpn-web.service  text eol=lf
deploy/ovpnweb.sudoers   text eol=lf
*.sh                     text eol=lf
*.py                     text eol=lf
*.yaml                   text eol=lf
*.yml                    text eol=lf
*.md                     text eol=lf

# Binarios. Van declarados uno a uno y no confiados a la autodetección: la
# regla '* text=auto eol=lf' de arriba normalizaría saltos de línea dentro de
# un archivo que git no reconociera como binario, y una fuente o un .ico así
# quedan corruptos sin que nada avise hasta que el navegador no los dibuja.
*.png  binary
*.jpg  binary
*.ico  binary
*.ttf  binary
*.woff binary
*.woff2 binary

# El manifest es JSON: texto, con LF como todo lo demás.
*.webmanifest text eol=lf
