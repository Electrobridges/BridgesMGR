[Unit]
Description=OpenVPN Manager Web — panel de administración
Documentation=https://github.com/Electrobridges/OpenVPN-Manager-Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ovpnweb
Group=ovpnweb
WorkingDirectory=/opt/ovpn-web
Environment=OVPN_WEB_CONFIG=/etc/ovpn-web/config.yaml
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ovpn-web/venv/bin/python -m app.servidor
Restart=on-failure
RestartSec=5

# --- Aislamiento -------------------------------------------------------
# NoNewPrivileges NO se puede activar: el panel llama a sudo para ejecutar
# /usr/local/sbin/ovpn-web-helper, y sudo es setuid. Activarlo rompería toda
# la gestión de certificados. El resto de restricciones compensan.
NoNewPrivileges=false

PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# Las dos rutas que el servicio necesita poder escribir.
#
# /etc/openvpn no es un descuido ni una laxitud: ProtectSystem=strict monta el
# sistema en solo lectura dentro del espacio de nombres del servicio, y los
# hijos lo heredan — también el helper lanzado con sudo, aunque sea root. Sin
# esta línea el panel no puede emitir, revocar ni restaurar un solo
# certificado, que es justo para lo que existe. Falla además con un mensaje de
# easyrsa que no menciona systemd por ningún lado.
#
# Si mueves la PKI (openvpn.easyrsa_path en config.yaml), esta línea tiene que
# seguirla. Hay una prueba que comprueba que cubre lo que declara el ejemplo.
ReadWritePaths=/var/lib/ovpn-web /etc/openvpn
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native

# 0077 para que la base de datos y lo que escriba el panel nazcan cerrados.
# Ojo: lo hereda todo lo que el panel lance, helper y easyrsa incluidos, así
# que la CRL saldría de gen-crl en 0600 y OpenVPN —que la relee siendo
# 'nobody'— dejaría de admitir a nadie. Por eso el helper le pone los permisos
# a mano después de regenerarla, en vez de fiarlo al umask.
UMask=0077

[Install]
WantedBy=multi-user.target
