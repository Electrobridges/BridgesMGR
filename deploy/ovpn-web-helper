#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Helper privilegiado de OpenVPN Manager Web.

Es lo ÚNICO que /etc/sudoers.d/ovpnweb autoriza a ejecutar como root. El panel
web corre sin privilegios y delega aquí las operaciones sobre la PKI.

Reglas de diseño, en orden de importancia:

  1. Nunca acepta rutas por argumento. Todas salen de /etc/ovpn-web/config.yaml,
     que es root:ovpnweb 0640. Si aceptara rutas del panel, un panel
     comprometido apuntaría easyrsa a un binario propio y sería root.
  2. Revalida el Common Name aquí, aunque el panel ya lo valide. El panel no
     es de fiar desde este lado de la frontera de privilegios.
  3. subprocess siempre con lista de argumentos, jamás shell=True.
  4. Antes de tocar la PKI hace copia de seguridad con marca de tiempo.
  5. Responde JSON por stdout; los errores van a stderr con código != 0.

Uso:
    ovpn-web-helper listar
    ovpn-web-helper revocar <CN>
    ovpn-web-helper restaurar <CN>
    ovpn-web-helper crear <CN>
    ovpn-web-helper ovpn <CN>
    ovpn-web-helper estado-servicio
    ovpn-web-helper rotar-tls-crypt

Lo que NO está aquí y no debe estarlo: reconstruir la CA. Necesitaría escribir
en server.conf, y quien pueda hacerlo mete un 'script-security 2' con un script
'up' y ejecuta código como root. Como el sudoers autoriza este binario entero y
no sus subcomandos, tenerlo aquí lo pondría al alcance de un panel comprometido.
Vive en deploy/reconstruir-ca.sh, que se lanza a mano y no está en el sudoers.
"""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime

try:
    import yaml
except ImportError:
    sys.stderr.write("Falta python3-yaml (apt install python3-yaml)\n")
    sys.exit(2)

CONFIG = "/etc/ovpn-web/config.yaml"

# Debe coincidir con app/core/validacion.py
CN_RE = re.compile(r'^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$')
RESERVADOS = {'server', 'ca'}

TIMEOUT = 120

# Marca que pide cifrar la clave privada del cliente. Es una palabra fija, no
# la contraseña: esa llega por stdin y no toca argv en ningún momento.
MARCA_CLAVE = "con-clave"

# Variable por la que se le pasa la contraseña a easyrsa. Va por el entorno del
# hijo y no por su línea de comandos, así que no aparece en 'ps'; el entorno de
# un proceso solo lo lee su dueño o root, y aquí ya somos root.
ENV_CLAVE = "OVPNWEB_PASSOUT"

MIN_CLAVE = 12


def error(mensaje, codigo=1):
    sys.stderr.write(mensaje.rstrip() + "\n")
    sys.exit(codigo)


def validar_cn(cn):
    """Revalidación independiente del CN. No confiamos en quien nos llama."""
    if not cn or len(cn) > 64 or not CN_RE.match(cn) or cn.lower() in RESERVADOS:
        error("Common Name no válido: %r" % cn)
    return cn


def cargar_config():
    if not os.path.exists(CONFIG):
        error("No existe %s" % CONFIG)

    st = os.stat(CONFIG)
    if st.st_uid != 0:
        error("%s debe pertenecer a root (uid actual: %d)" % (CONFIG, st.st_uid))
    if st.st_mode & 0o002:
        error("%s no puede tener permiso de escritura para todos" % CONFIG)

    with open(CONFIG, "r", encoding="utf-8") as f:
        return yaml.safe_load(f) or {}


def rutas_pki(cfg):
    base = (cfg.get("openvpn") or {}).get("easyrsa_path", "/etc/openvpn/easy-rsa")
    return {
        "base": base,
        "easyrsa": os.path.join(base, "easyrsa"),
        "pki": os.path.join(base, "pki"),
        "issued": os.path.join(base, "pki", "issued"),
        "private": os.path.join(base, "pki", "private"),
        "reqs": os.path.join(base, "pki", "reqs"),
        "index": os.path.join(base, "pki", "index.txt"),
        "ca": os.path.join(base, "pki", "ca.crt"),
        "crl": os.path.join(base, "pki", "crl.pem"),
        "backups": os.path.join(base, "pki", "ovpn-web-backups"),
    }


# Las dos rutas estándar del server.conf, en orden. Las dos unidades que
# conviven en Debian no son intercambiables: openvpn@server lee la primera y
# openvpn-server@server la segunda. Se prueban ambas cuando openvpn.server_conf
# no está declarado.
SERVER_CONF_ESTANDAR = (
    "/etc/openvpn/server.conf",
    "/etc/openvpn/server/server.conf",
)


def _ruta_server_conf(cfg):
    """
    La declarada manda; si no existe o no hay, se prueban las estándar.

    Que una ruta mal escrita caiga a la detección automática es deliberado: esta
    clave es un escape para instalaciones raras, y una errata en ella no debe
    dejar peor el resultado que no haberla puesto —el certificado del servidor
    volvería a colarse en la lista de clientes sin decir nada.
    """
    candidatas = []

    declarada = ((cfg.get("openvpn") or {}).get("server_conf") or "").strip()
    if declarada:
        candidatas.append(declarada)
    candidatas.extend(SERVER_CONF_ESTANDAR)

    for ruta in candidatas:
        if os.path.isfile(ruta):
            return ruta
    return None


def cn_del_servidor(cfg):
    """
    CN del certificado con el que se identifica el propio servidor OpenVPN.

    Hay que excluirlo de la lista de clientes: es un certificado más dentro de
    la misma PKI y, sin esto, el panel lo enseña como si fuera un cliente, con
    su botón de revocar al lado. RESERVADOS no basta porque compara exacto y los
    instaladores al uso generan el nombre con un sufijo aleatorio, del tipo
    'server_SU1O2eUJ8SUV0x2W'.

    Se deduce del certificado que declara el server.conf, que es la fuente
    autoritativa. Queda descartado un prefijo tipo «empieza por server»: dejaría
    fuera a un cliente legítimo llamado 'server-madrid'.

    Esto solo lo puede hacer el helper, y por eso vive aquí y no también en
    app/core/validacion.py como CN_RE y RESERVADOS: el certificado del servidor
    pertenece a root y el panel, que corre como ovpnweb, no lo alcanza.

    Devuelve None si no hay forma de averiguarlo. Es una capa por encima de
    RESERVADOS, no un sustituto: si falla, el filtro de siempre sigue en pie.
    """
    ovpn = cfg.get("openvpn") or {}

    # Escape para instalaciones raras. Si está declarado se cree y no se toca
    # el disco.
    declarado = (ovpn.get("cn_servidor") or "").strip()
    if declarado:
        return declarado

    conf = _ruta_server_conf(cfg)
    if not conf:
        return None

    cert = None
    try:
        with open(conf, "r", encoding="utf-8", errors="replace") as f:
            for linea in f:
                m = re.match(r'^\s*cert\s+(\S+)', linea)
                if m:
                    cert = m.group(1)
    except OSError:
        return None

    if not cert:
        return None

    # Ojo: las rutas del server.conf pueden ser relativas. OpenVPN las resuelve
    # contra su directorio de trabajo, que la unidad fija con --cd al directorio
    # del propio archivo. Sin esto se busca el certificado donde no está.
    if not os.path.isabs(cert):
        cert = os.path.join(os.path.dirname(conf), cert)

    if not os.path.isfile(cert):
        return None

    try:
        salida = subprocess.run(
            ["openssl", "x509", "-noout", "-subject", "-in", cert],
            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
            timeout=10, check=True,
        ).stdout.decode("utf-8", "replace")
    except (OSError, subprocess.SubprocessError):
        return None

    m = re.search(r'CN\s*=\s*([^,/\n]+)', salida)
    return m.group(1).strip() if m else None


def _es_del_servidor(cn, propio):
    """RESERVADOS más el CN real del servidor, si se ha podido averiguar"""
    bajo = cn.lower()
    return bajo in RESERVADOS or (propio is not None and bajo == propio.lower())


def leer_clave_de_stdin():
    """
    Lee de stdin la contraseña con la que cifrar la clave privada del cliente.

    Por stdin y no por argumento: argv es público en /proc, así que cualquiera
    con una cuenta en el servidor podría leerla con un 'ps' en el momento
    justo. Se revalida aquí aunque el panel ya valide, por el mismo motivo que
    el CN: desde este lado de la frontera el panel no es de fiar.
    """
    primera = sys.stdin.read().split("\n", 1)[0].rstrip("\r")

    if len(primera) < MIN_CLAVE:
        error("La contraseña del certificado debe tener al menos %d caracteres"
              % MIN_CLAVE)

    return primera


def emitir_cliente(rutas, cn, clave):
    """
    Emite el certificado del cliente, cifrando su clave privada si hay contraseña.

    'nopass' y '--passout' son excluyentes en easy-rsa, así que es uno u otro y
    nunca los dos.
    """
    if clave is None:
        correr_easyrsa(rutas, ["build-client-full", cn, "nopass"])
    else:
        correr_easyrsa(rutas, ["build-client-full", cn], clave=clave)


def asegurar_crl_legible(rutas):
    """
    Deja la CRL legible para todos después de regenerarla.

    OpenVPN la relee en cada conexión, y para entonces ya ha bajado a 'nobody'.
    Si easyrsa la deja en 0600 —depende del umask con el que corra— revocar
    "funciona" y a partir de ese momento no entra ni un cliente, sin que nada
    lo diga. Una CRL es pública por definición: no hay nada que proteger aquí.
    """
    if not os.path.isfile(rutas["crl"]):
        error("gen-crl no dejó ninguna CRL en %s" % rutas["crl"])

    try:
        os.chmod(rutas["crl"], 0o644)
    except OSError as e:
        error("No se pudo dejar la CRL legible (%s): %s" % (rutas["crl"], e))


def correr_easyrsa(rutas, args, entrada=None, clave=None):
    """
    Ejecuta easyrsa en su directorio. Devuelve stdout; aborta si falla.

    Siempre con --batch. Aquí no hay nadie a quien preguntar: easy-rsa 3.2
    empezó a pedir confirmación también en build-client-full, y sin esto el
    panel no puede emitir un solo certificado en Debian 13. Las versiones
    anteriores no preguntaban, así que el fallo aparece al actualizar el
    sistema operativo, no al tocar este código.

    Si se pasa 'clave', se le da a easyrsa por el entorno y no como argumento.
    OpenSSL admite 'pass:', y sería una línea más corta, pero pondría la
    contraseña del cliente en la línea de comandos: cualquiera con un 'ps' en
    el servidor la leería. Por el entorno solo la ve root, que ya es quien
    corre esto.
    """
    if not os.path.isfile(rutas["easyrsa"]):
        error("No se encontró easyrsa en %s" % rutas["easyrsa"])

    entorno = None
    if clave is not None:
        args = ["--passout=env:%s" % ENV_CLAVE] + list(args)
        entorno = dict(os.environ, **{ENV_CLAVE: clave})

    try:
        proc = subprocess.run(
            [rutas["easyrsa"], "--batch"] + list(args),
            cwd=rutas["base"],
            capture_output=True,
            text=True,
            input=entrada,
            env=entorno,
            timeout=TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        error("easyrsa %s excedió %d segundos" % (" ".join(args), TIMEOUT))

    if proc.returncode != 0:
        # Los dos flujos, no uno. easyrsa 3.2 escribe separadores decorativos
        # ('-----') en stderr y el motivo real en stdout: quedarse con stderr
        # cuando no está vacío reporta la decoración y esconde la causa. Se vio
        # en un servidor real, donde el panel decía '-----' y nada más.
        detalle = "\n".join(
            parte.strip() for parte in (proc.stdout, proc.stderr) if parte and parte.strip()
        )
        error("easyrsa %s falló (código %d): %s"
              % (" ".join(args), proc.returncode, detalle or "sin salida"))

    return proc.stdout


def leer_pem(ruta, etiqueta="CERTIFICATE"):
    """
    Extrae solo el bloque PEM del archivo.

    Los .crt de easyrsa llevan delante el volcado en texto del certificado;
    embeberlo entero en el .ovpn funciona pero ensucia el archivo.
    """
    if not os.path.isfile(ruta):
        error("No se encontró %s" % ruta)

    with open(ruta, "r", encoding="utf-8", errors="replace") as f:
        contenido = f.read()

    inicio = contenido.find("-----BEGIN")
    if inicio == -1:
        error("%s no contiene un bloque PEM" % ruta)

    return contenido[inicio:].strip()


def respaldar(rutas, cn):
    """Copia index.txt y los archivos del CN antes de modificarlos"""
    marca = datetime.now().strftime("%Y%m%d-%H%M%S")
    destino = os.path.join(rutas["backups"], "%s-%s" % (cn, marca))
    os.makedirs(destino, mode=0o700, exist_ok=True)

    guardados = []
    candidatos = [
        rutas["index"],
        os.path.join(rutas["issued"], "%s.crt" % cn),
        os.path.join(rutas["private"], "%s.key" % cn),
        os.path.join(rutas["reqs"], "%s.req" % cn),
    ]

    for origen in candidatos:
        if os.path.isfile(origen):
            shutil.copy2(origen, destino)
            guardados.append(os.path.basename(origen))

    return {"directorio": destino, "archivos": guardados}


# --------------------------------------------------------------- subcomandos

def cmd_listar(cfg):
    rutas = rutas_pki(cfg)
    propio = cn_del_servidor(cfg)
    validos = []
    revocados = []

    if os.path.isdir(rutas["issued"]):
        for nombre in os.listdir(rutas["issued"]):
            if nombre.endswith(".crt"):
                cn = nombre[:-4]
                if not _es_del_servidor(cn, propio):
                    validos.append(cn)

    if os.path.isfile(rutas["index"]):
        with open(rutas["index"], "r", encoding="utf-8", errors="replace") as f:
            for linea in f:
                if not linea.startswith("R"):
                    continue
                partes = linea.split("\t")
                if len(partes) < 6:
                    continue
                m = re.search(r'/CN=([^/\n]+)', partes[5])
                if m and not _es_del_servidor(m.group(1), propio):
                    revocados.append(m.group(1))

    # Un CN revocado sigue teniendo su .crt en issued/ hasta que se reemite
    revocados = sorted(set(revocados))
    validos = sorted(set(validos) - set(revocados))

    return {"validos": validos, "revocados": revocados}


def cmd_revocar(cfg, cn):
    rutas = rutas_pki(cfg)
    respaldo = respaldar(rutas, cn)

    correr_easyrsa(rutas, ["revoke", cn], entrada="yes\n")
    correr_easyrsa(rutas, ["gen-crl"])
    asegurar_crl_legible(rutas)

    return {
        "ok": True,
        "accion": "revocar",
        "cn": cn,
        "respaldo": respaldo,
        "requiere_reinicio": True,
    }


def cmd_restaurar(cfg, cn, clave=None):
    """
    Reemite el certificado de un cliente revocado.

    easyrsa no sabe "des-revocar": hay que sacar la entrada del índice y
    retirar los archivos previos para poder emitir uno nuevo con el mismo CN.
    Todo se respalda antes.
    """
    rutas = rutas_pki(cfg)
    respaldo = respaldar(rutas, cn)

    if os.path.isfile(rutas["index"]):
        with open(rutas["index"], "r", encoding="utf-8", errors="replace") as f:
            lineas = f.readlines()

        marca = "/CN=%s" % cn
        # Coincidencia exacta del CN: '/CN=juan' no debe borrar '/CN=juanito'
        conservadas = [l for l in lineas if not re.search(
            r'/CN=%s(?:/|$)' % re.escape(cn), l.rstrip("\n"))]

        if len(conservadas) != len(lineas):
            with open(rutas["index"], "w", encoding="utf-8") as f:
                f.writelines(conservadas)
        elif marca not in "".join(lineas):
            error("'%s' no aparece en el índice de la PKI" % cn)

    for ruta in (os.path.join(rutas["issued"], "%s.crt" % cn),
                 os.path.join(rutas["private"], "%s.key" % cn),
                 os.path.join(rutas["reqs"], "%s.req" % cn)):
        if os.path.isfile(ruta):
            os.remove(ruta)

    emitir_cliente(rutas, cn, clave)
    correr_easyrsa(rutas, ["gen-crl"])
    asegurar_crl_legible(rutas)

    return {
        "ok": True,
        "accion": "restaurar",
        "cn": cn,
        "respaldo": respaldo,
        "cifrada": clave is not None,
        "requiere_reinicio": True,
    }


def cmd_crear(cfg, cn, clave=None):
    rutas = rutas_pki(cfg)

    if os.path.isfile(os.path.join(rutas["issued"], "%s.crt" % cn)):
        error("Ya existe un certificado para '%s'" % cn)

    emitir_cliente(rutas, cn, clave)

    return {
        "ok": True,
        "accion": "crear",
        "cn": cn,
        "cifrada": clave is not None,
        "requiere_reinicio": False,
    }


def cmd_ovpn(cfg, cn):
    """Arma el .ovpn del cliente con todo embebido"""
    rutas = rutas_pki(cfg)
    cliente = cfg.get("cliente_ovpn") or {}

    remote = cliente.get("remote_host")
    if not remote:
        error("Falta cliente_ovpn.remote_host en %s" % CONFIG)

    crt = os.path.join(rutas["issued"], "%s.crt" % cn)
    key = os.path.join(rutas["private"], "%s.key" % cn)

    if not os.path.isfile(crt):
        error("No existe certificado para '%s'" % cn)

    partes = [
        "client",
        "dev tun",
        "proto %s" % cliente.get("proto", "udp"),
        "remote %s %s" % (remote, cliente.get("remote_puerto", 1194)),
        "resolv-retry infinite",
        "nobind",
        "persist-key",
        "persist-tun",
        "remote-cert-tls server",
        "cipher %s" % cliente.get("cipher", "AES-256-CBC"),
        "verb 3",
        "",
        "<ca>", leer_pem(rutas["ca"]), "</ca>",
        "<cert>", leer_pem(crt), "</cert>",
        "<key>", leer_pem(key), "</key>",
    ]

    tls_crypt = cliente.get("tls_crypt")
    if tls_crypt and os.path.isfile(tls_crypt):
        partes += ["<tls-crypt>", leer_pem(tls_crypt), "</tls-crypt>"]

    return {"ok": True, "cn": cn, "contenido": "\n".join(partes) + "\n"}


def cmd_estado_servicio(cfg):
    servicio = (cfg.get("openvpn") or {}).get("servicio", "openvpn@server")

    if not re.match(r'^[A-Za-z0-9@._-]+$', servicio):
        error("Nombre de servicio no válido en la configuración")

    try:
        proc = subprocess.run(
            ["systemctl", "is-active", servicio],
            capture_output=True, text=True, timeout=15,
        )
        estado = proc.stdout.strip() or proc.stderr.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return {"activo": False, "estado": "desconocido: %s" % e, "servicio": servicio}

    return {"activo": estado == "active", "estado": estado, "servicio": servicio}


def _nombre_servicio(cfg):
    servicio = (cfg.get("openvpn") or {}).get("servicio", "openvpn@server")
    if not re.match(r'^[A-Za-z0-9@._-]+$', servicio):
        error("Nombre de servicio no válido en la configuración")
    return servicio


def cmd_rotar_tls_crypt(cfg):
    """
    Genera una clave tls-crypt nueva y reinicia OpenVPN.

    La ruta sale de config.yaml, nunca por argumento (regla 1): si viniera del
    panel, un panel comprometido apuntaría a un archivo cualquiera y lo pisaría
    con esto, como root.

    Esto SÍ puede vivir en el helper, a diferencia de la reconstrucción de la
    CA. Aquella necesitaría escribir en server.conf, y quien pueda hacerlo mete
    un 'script-security 2' con un script 'up' y ejecuta código como root. Rotar
    la clave no toca server.conf: la directiva ya apunta al archivo y solo se
    reemplaza su contenido. Y dejar clientes fuera ya está al alcance de quien
    controle el panel, que puede revocarlos.

    Nunca devuelve material de clave: solo una huella recortada, que es lo que
    permite comprobar que cambió sin exponerla.
    """
    ruta = (cfg.get("cliente_ovpn") or {}).get("tls_crypt") or ""
    if not ruta:
        error("No hay cliente_ovpn.tls_crypt en la configuración: nada que rotar")
    if not os.path.isfile(ruta):
        error("No existe %s" % ruta)

    servicio = _nombre_servicio(cfg)

    sello = datetime.now().strftime("%Y%m%d-%H%M%S")
    respaldo = "%s.bak.%s" % (ruta, sello)
    try:
        shutil.copy2(ruta, respaldo)
        os.chmod(respaldo, 0o600)
    except OSError as e:
        error("No se pudo respaldar la clave actual (%s): %s" % (respaldo, e))

    temporal = "%s.nueva.%s" % (ruta, sello)
    try:
        proc = subprocess.run(
            ["openvpn", "--genkey", "secret", temporal],
            capture_output=True, text=True, timeout=TIMEOUT,
        )
        if proc.returncode != 0:
            error("openvpn --genkey falló: %s" % (proc.stderr or proc.stdout).strip())

        # Se comprueba lo generado ANTES de pisar lo que funciona: una clave a
        # medias dejaría la VPN sin admitir a nadie.
        with open(temporal, "r", encoding="utf-8", errors="replace") as f:
            contenido = f.read()
        lineas = [l for l in contenido.splitlines()
                  if re.match(r'^[0-9a-f]{32}$', l.strip())]
        if "OpenVPN Static key V1" not in contenido or len(lineas) != 16:
            error("La clave generada no tiene el formato esperado")

        # 0600 explícito y no fiado al umask: la unidad lleva UMask=0077 y lo
        # heredan los hijos, pero eso es una coincidencia afortunada, no una
        # garantía de este archivo.
        os.replace(temporal, ruta)
        os.chmod(ruta, 0o600)
        os.chown(ruta, 0, 0)
    except OSError as e:
        error("No se pudo instalar la clave nueva: %s" % e)
    finally:
        if os.path.exists(temporal):
            try:
                os.unlink(temporal)
            except OSError:
                pass

    def _activo():
        try:
            p = subprocess.run(["systemctl", "is-active", servicio],
                               capture_output=True, text=True, timeout=15)
            return p.stdout.strip() == "active"
        except (OSError, subprocess.TimeoutExpired):
            return False

    subprocess.run(["systemctl", "restart", servicio],
                   capture_output=True, timeout=TIMEOUT)
    time.sleep(3)

    if not _activo():
        # Dejar la VPN caída con una clave nueva es el peor resultado posible.
        shutil.copy2(respaldo, ruta)
        os.chmod(ruta, 0o600)
        subprocess.run(["systemctl", "restart", servicio],
                       capture_output=True, timeout=TIMEOUT)
        time.sleep(2)
        error("%s no volvió a levantar con la clave nueva. Se ha restaurado la "
              "anterior desde %s" % (servicio, respaldo))

    with open(ruta, "rb") as f:
        huella = hashlib.sha256(f.read()).hexdigest()[:16]

    return {
        "ok": True,
        "accion": "rotar-tls-crypt",
        "respaldo": respaldo,
        "huella": huella,
        "servicio": servicio,
    }


COMANDOS_CON_CN = {
    "revocar": cmd_revocar,
    "restaurar": cmd_restaurar,
    "crear": cmd_crear,
    "ovpn": cmd_ovpn,
}

COMANDOS_SIN_CN = {
    "listar": cmd_listar,
    "estado-servicio": cmd_estado_servicio,
    "rotar-tls-crypt": cmd_rotar_tls_crypt,
}

# Los únicos que emiten una clave privada nueva y, por tanto, los únicos que
# pueden cifrarla.
COMANDOS_CON_CLAVE = {"crear", "restaurar"}


def main():
    if os.geteuid() != 0:
        error("Este helper debe ejecutarse como root (vía sudo)")

    if len(sys.argv) < 2:
        error("Uso: ovpn-web-helper <listar|revocar|restaurar|crear|ovpn|estado-servicio|rotar-tls-crypt> [CN]")

    sub = sys.argv[1]
    cfg = cargar_config()

    if sub in COMANDOS_SIN_CN:
        if len(sys.argv) != 2:
            error("'%s' no acepta argumentos" % sub)
        resultado = COMANDOS_SIN_CN[sub](cfg)

    elif sub in COMANDOS_CON_CN:
        if len(sys.argv) not in (3, 4):
            error("Uso: ovpn-web-helper %s <CN> [%s]" % (sub, MARCA_CLAVE))

        cn = validar_cn(sys.argv[2])

        # El certificado del servidor no es un cliente y ninguna operación puede
        # tocarlo. Se comprueba aquí además de al listar, porque no salir en la
        # lista no impide que alguien invoque la operación a mano —y el helper
        # no se fía de quien le llama.
        propio = cn_del_servidor(cfg)
        if propio is not None and cn.lower() == propio.lower():
            error("'%s' es el certificado del propio servidor OpenVPN, no un cliente" % cn)

        clave = None

        if len(sys.argv) == 4:
            # El cuarto argumento es una marca fija, jamás la contraseña: esa
            # llega por stdin y no pasa por argv en ningún momento.
            if sub not in COMANDOS_CON_CLAVE or sys.argv[3] != MARCA_CLAVE:
                error("'%s' no admite '%s'" % (sub, sys.argv[3]))
            clave = leer_clave_de_stdin()

        if sub in COMANDOS_CON_CLAVE:
            resultado = COMANDOS_CON_CN[sub](cfg, cn, clave)
        else:
            resultado = COMANDOS_CON_CN[sub](cfg, cn)

    else:
        error("Subcomando desconocido: %s" % sub)

    json.dump(resultado, sys.stdout)
    sys.stdout.write("\n")


if __name__ == "__main__":
    main()
